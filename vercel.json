{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/assets/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/assets/css/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
    {"source": "/assets/js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]}
  ]
}
